OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://apilink.olinkdata.com/v1
OPENAI_MODEL=gpt-5.5
APP_PASSWORD=change_this_password

# Optional remote speech recognition through Alibaba Cloud Model Studio / DashScope Fun-ASR.
TRANSCRIBE_PROVIDER=dashscope-fun-asr
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_ASR_MODEL=fun-asr
DASHSCOPE_ASR_TIMEOUT_MS=90000
APP_PUBLIC_URL=https://your-render-service.onrender.com

# Local Whisper speech recognition. Requires Python deps and ffmpeg.
LOCAL_WHISPER_ENABLED=false
LOCAL_WHISPER_ENGINE=transformers
LOCAL_WHISPER_MODEL=panlr/whisper-finetune-teochew
LOCAL_WHISPER_LANGUAGE=zh
LOCAL_WHISPER_TIMEOUT_MS=300000

# Optional: OpenAI official Whisper CLI instead of Hugging Face Transformers.
# LOCAL_WHISPER_ENGINE=openai-cli
# LOCAL_WHISPER_COMMAND=whisper
# LOCAL_WHISPER_MODEL=small
